{
  "version": 1,
  "author": "Smart Library ESP32 Wokwi",
  "editor": "wokwi",
  "parts": [
    {
      "type": "board-esp32-devkit-c-v4",
      "id": "esp",
      "top": 0,
      "left": 0,
      "attrs": {}
    },
    {
      "type": "board-ssd1306",
      "id": "oled",
      "top": -160,
      "left": 10,
      "attrs": { "i2cAddress": "0x3c" }
    },
    {
      "type": "board-mfrc522",
      "id": "rfid",
      "top": 30,
      "left": -340,
      "attrs": {}
    },
    {
      "type": "wokwi-buzzer",
      "id": "bz1",
      "top": -120,
      "left": 230,
      "attrs": { "volume": "0.5" }
    },
    {
      "type": "wokwi-led",
      "id": "led_green",
      "top": 50,
      "left": 250,
      "attrs": { "color": "green", "label": "SUCCESS" }
    },
    {
      "type": "wokwi-resistor",
      "id": "r_green",
      "top": 90,
      "left": 190,
      "attrs": { "resistance": "220" }
    },
    {
      "type": "wokwi-led",
      "id": "led_red",
      "top": 150,
      "left": 250,
      "attrs": { "color": "red", "label": "ERROR" }
    },
    {
      "type": "wokwi-resistor",
      "id": "r_red",
      "top": 190,
      "left": 190,
      "attrs": { "resistance": "220" }
    }
  ],
  "connections": [
    [ "esp:TX", "$if:serial:rx", "", [] ],
    [ "esp:RX", "$if:serial:tx", "", [] ],

    [ "oled:GND", "esp:GND.1", "black", [] ],
    [ "oled:VCC", "esp:3V3", "red", [] ],
    [ "oled:SDA", "esp:21", "blue", [] ],
    [ "oled:SCL", "esp:22", "yellow", [] ],

    [ "rfid:3.3V", "esp:3V3", "red", [] ],
    [ "rfid:RST", "esp:4", "orange", [] ],
    [ "rfid:GND", "esp:GND.1", "black", [] ],
    [ "rfid:MISO", "esp:19", "purple", [] ],
    [ "rfid:MOSI", "esp:23", "green", [] ],
    [ "rfid:SCK", "esp:18", "brown", [] ],
    [ "rfid:SDA", "esp:5", "cyan", [] ],

    [ "bz1:1", "esp:GND.2", "black", [] ],
    [ "bz1:2", "esp:25", "red", [] ],

    [ "esp:26", "r_green:1", "green", [] ],
    [ "r_green:2", "led_green:A", "green", [] ],
    [ "led_green:C", "esp:GND.2", "black", [] ],

    [ "esp:27", "r_red:1", "red", [] ],
    [ "r_red:2", "led_red:A", "red", [] ],
    [ "led_red:C", "esp:GND.2", "black", [] ]
  ]
}
